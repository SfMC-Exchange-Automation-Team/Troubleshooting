<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TLC Toolbox"
        SizeToContent="Height"
        Height="Auto" MaxHeight="700" MinHeight="240"
        Width="720" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource CanvasBrush}">

    <!--
        One detail window, reused by every dashboard tile.

        A tile has room for four words and a tooltip has room for a sentence. The thing
        behind the number - which crashes, which log folder, what the tunnel actually is -
        needs room to breathe and sometimes an action, and building a separate window per
        tile would be nine near-identical files.

        The theme is merged by Import-TlcXaml at parse time, the same way the wizard does
        it, so this follows dark mode without knowing anything about it.

        THREE THINGS THIS LAYOUT FIXES, all of which were inherited rather than chosen:

        1. The body was monospace. Cascadia Mono is right for a diff and wrong for prose,
           and most of what these windows carry is prose - a sentence explaining what the
           number means, then a path. Monospace made an explanation look like console
           output, which is the "why am I reading a terminal" feeling.

        2. The body did not wrap, so a long path pushed a horizontal scrollbar onto the
           window and the sentence ran off the right edge. Reading a sentence by dragging
           a scrollbar sideways is the worst possible way to read a sentence.

        3. The body sat inside FlatTextBox, which is the style for single-line INPUTS -
           MinHeight 34, VerticalContentAlignment Center. In a tall box that centres the
           content vertically, so a short body floated in the middle of a large empty
           panel with dead space above and below it.

        The window is deliberately wider than before and sizes its HEIGHT to the content,
        capped by MaxHeight. These are read, not filled in, and the content varies from
        two sentences to a forty-line update history: a fixed height meant the short ones
        floated in a mostly-empty panel while the long ones scrolled anyway. A wider
        measure also means fewer lines and less scrolling for the same text.

        Row 2 is STAR, not Auto. With Auto it keeps its full desired height when MaxHeight
        clamps the window, so the overflow comes off the BOTTOM of the grid and the button
        row is clipped - measured 2026-09-21 with the Close button sliced in half on a long
        sign-in detail. Star lets the content row absorb the squeeze instead, which is what
        puts the scrollbar back where it belongs and keeps the buttons on screen at every
        length. SizeToContent still measures correctly: under an infinite measure a star row
        behaves as Auto, so the window still shrinks to short content.
        MinHeight stops a one-line body producing a comically small dialog.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="__THEME_URI__" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Local overrides only. Theme.xaml is EPO's file, copied verbatim, and is
                never edited - FlatTextBox is correct for the single-line inputs it was
                built for, so the fix belongs here rather than there.
            -->
            <Style x:Key="DetailBodyBox" TargetType="TextBox" BasedOn="{StaticResource FlatTextBox}">
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <!--
                    Tabular figures. Segoe UI Variable is proportional, which is right for
                    prose and wrong for the columns of dates and version numbers in an
                    update history - "26225.1801" and "26225.1808" came out different
                    widths and the arrows between them went ragged. NumeralAlignment
                    Tabular makes digits fixed-width while letters stay proportional, so
                    numeric columns line up without dragging the whole panel back to a
                    monospace font.
                -->
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
                <!-- Sentences read better with a little air between the lines. -->
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled" />
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="90" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="DetailHeading" Grid.Row="0"
                   Style="{StaticResource SectionText}"
                   FontSize="17"
                   TextWrapping="Wrap"
                   Text="Detail" />

        <TextBlock x:Name="DetailSummary" Grid.Row="1"
                   Style="{StaticResource BodyText}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   Margin="0,6,0,0"
                   Text="" />

        <!--
            One scrollable region for facts and prose together, so a long body scrolls as
            a single document rather than as two panes that scroll independently.
        -->
        <Border Grid.Row="2" Margin="0,16,0,0"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="18,16,18,16">
                <StackPanel>
                    <!--
                        Structured facts, populated in code. A real two-column layout
                        rather than names padded with spaces to line up - that trick only
                        works in a monospace font, and it was half the reason the body was
                        monospace in the first place.
                    -->
                    <Grid x:Name="DetailFacts" Margin="0,0,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                    </Grid>

                    <!-- Separator only when both halves are present. -->
                    <Border x:Name="DetailSeparator"
                            Height="1" Margin="0,14,0,14"
                            Background="{DynamicResource BorderBrush}"
                            Visibility="Collapsed" />

                    <!--
                        Read-only rather than a label: the body is often a path, an event
                        message or a DNS chain, and the first thing anyone wants to do with
                        those is copy them.
                    -->
                    <TextBox x:Name="DetailBody"
                             Style="{StaticResource DetailBodyBox}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             Text="" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!--
            Only the action button lives here. There is no Close button: the title bar
            already has an X, and a second way out cost a row of height on a window that
            was already clipping its own buttons.

            Escape still closes, which is what IsCancel on that button used to provide -
            it is wired in code now rather than being a side effect of a control that no
            longer exists. The panel stays even when the action button is collapsed, so
            the grid keeps its shape.
        -->
        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="DetailActionButton"
                    Style="{StaticResource SecondaryButton}"
                    Content="Open"
                    Visibility="Collapsed"
                    Margin="0,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
